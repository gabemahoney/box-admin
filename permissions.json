{
  "additionalDirectories": [
    "~/image_drop",
    "/tmp",
    "~/projects"
  ],
  "allow": [
    "Bash",
    "Read(~/**)",
    "Read(//tmp/**)",
    "Edit(~/**)",
    "Edit(//tmp/**)",
    "Glob",
    "Grep",
    "WebFetch",
    "WebSearch",
    "Task",
    "mcp__bees__*",
    "mcp__atlassian__*",
    "mcp__slack-channel-router__*",
    "mcp__agent-director__*",
    "RemoteTrigger",
    "CronCreate",
    "CronDelete",
    "CronList"
  ],
  "ask": [
    "Bash(git reset --hard*)",
    "Bash(git clean*)",
    "Bash(git stash*)"
  ],
  "defaultMode": "acceptEdits",
  "deny": [
    "AskUserQuestion",
    "Bash(tmux kill-server*)",
    "Bash(pkill tmux*)",
    "Bash(killall tmux*)",
    "Bash(kill $(pgrep tmux)*)",
    "Bash(claude)",
    "Bash(claude *)",
    "Read(~/.ssh/**)",
    "Edit(~/.ssh/**)",
    "Read(~/.aws/**)",
    "Edit(~/.aws/**)",
    "Read(~/.config/gh/**)",
    "Edit(~/.config/gh/**)"
  ]
}
